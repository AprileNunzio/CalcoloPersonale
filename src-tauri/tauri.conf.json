{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calcolo Personale",
  "version": "0.1.4",
  "identifier": "it.nunziotech.calcolopersonale",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "NunzioTech",
    "shortDescription": "Gestione fascicoli personale ATA",
    "category": "Productivity",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "Italian",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
